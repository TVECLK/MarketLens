BACKEND_URL=http://backend:8080/api/v1/crawler

THUNDER_BASE_URL=https://thunder:8090
THUNDER_CLIENT_ID=wHoZsmN2rZYHwBA8zNVerw

#Generate client secret and add it here
THUNDER_CLIENT_SECRET=
THUNDER_RESOURCE=https://tvec.gov.lk

# Use "true" in local development. It means that you say to AsyncClient of ThunderID not to check TLS
THUNDER_INSECURE_TLS=true

MAX_JOB_FAILURE_RATIO=0.2
MIN_JOBS_FOR_FAILURE=20

# Email alerts when a crawler fails.
# SMTP_HOST has no default: alert emails are skipped until it is set.
ALERT_EMAILS_ENABLED=true
SMTP_HOST=
# How the connection to the SMTP server is secured. Allowed values:
#   starttls - starts plain, then upgrades to TLS (default port 587). The default
#   ssl      - TLS from the start (default port 465)
#   none     - no encryption (default port 25). Only for a trusted relay or a test server
# Any other value skips the alert emails.
SMTP_SECURITY=starttls
# Empty uses the default port of SMTP_SECURITY
SMTP_PORT=587
# Leave the username and password empty for a server that needs no login
SMTP_USERNAME=<SMTP_USERNAME>
SMTP_PASSWORD=<SMTP_PASSWORD>
ALERT_FROM_EMAIL=<SENDER_EMAIL@domain.com>
# Comma separated list of emails
ALERT_RECIPIENTS=
APP_NAME=Labour Market Analysis System
DASHBOARD_URL=http://localhost:3000/
