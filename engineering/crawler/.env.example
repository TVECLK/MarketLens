BACKEND_URL=http://backend:8080/api/v1/crawler

THUNDER_BASE_URL=https://thunder:8090
THUNDER_CLIENT_ID=wHoZsmN2rZYHwBA8zNVerw

#Generate client secret and add it here
THUNDER_CLIENT_SECRET=
THUNDER_RESOURCE=https://tvec.gov.lk

# Use "true" in local development. It means that you say to AsyncClient of ThunderID not to check TLS
THUNDER_INSECURE_TLS=true

MAX_JOB_FAILURE_RATIO=0.2
MIN_JOBS_FOR_FAILURE=20

# Email alerts when a crawler fails (Google SMTP). Use a Google App Password for SMTP_PASSWORD
ALERT_EMAILS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
# Comma separated list of the admins
ALERT_RECIPIENTS=
DASHBOARD_URL=http://localhost:3000/
